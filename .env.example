# ==========================================
# Vee Rubber G-Procurement Tracker - Config Template (.env.example)
# บริษัท วีรับเบอร์ คอร์ปอเรชั่น จำกัด (Vee Rubber Corporation Ltd.)
# สำเนาไฟล์นี้เป็น .env เพื่อใส่ข้อมูลจริงของคุณ
# ไฟล์ .env จะถูก .gitignore บล็อกไว้ ไม่ถูกอัปโหลดขึ้น GitHub เด็ดขาด
# ==========================================

# 1. บัญชีผู้ดูแลระบบสูงสุด (Super Admin Credentials)
ADMIN_EMAIL=admin@veerubber.co.th
ADMIN_PASSWORD=your_secure_password_here
RECOVERY_KEY=VEERUBBER-2026-SAFE-RECOVERY

# 2. Cloudflare D1 & Worker API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
API_KEY=your_api_secret_key_here
JWT_SECRET=your_jwt_secret_token_here

# 3. Gmail SMTP สำหรับส่งอีเมลสรุปงานประมูลประจำวัน (Daily Tender Digest)
GMAIL_USER=veerubber.procurement@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
GMAIL_RECIPIENTS=admin@veerubber.co.th

# 4. CapSolver API สำหรับแก้ Cloudflare Turnstile e-GP process5 อัตโนมัติ
CAPSOLVER_API_KEY=your_capsolver_api_key_here
